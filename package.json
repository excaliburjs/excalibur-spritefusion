{
  "name": "@excaliburjs/plugin-spritefusion",
  "version": "1.0.0-alpha.0",
  "description": "Excalibur Sprite Fusion Plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/excaliburjs/excalibur-spritefusion"
  },
  "main": "build/esm/excalibur-spritefusion.min.js",
  "typings": "build/esm/src/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/esm/src/index.d.ts",
      "import": "./build/esm/excalibur-spritefusion.js"
    }
  },
  "scripts": {
    "start": "vite example",
    "watch": "vite dev",
    "types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
    "type-check": "tsc --noEmit",
    "build:esm": "vite build",
    "build": "npm run build:esm && npm run types",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test": "npm run test:e2e"
  },
  "author": "Erik Onarheim",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "cross-env": "7.0.3",
    "excalibur": "0.33.0-alpha.247",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "peerDependencies": {
    "excalibur": ">=0.33.0-alpha.247"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error",
      "version": ">=11"
    }
  }
}
